# Copy to backend/.env for local development.
# DATABASE_URL is required (no credentials are hard-coded in application source).
# The user/password below match docker-compose Postgres for local use only.

DATABASE_URL=postgresql+asyncpg://astroimage:astroimage@localhost:5432/astroimage
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=info
ENVIRONMENT=development
OTLP_ENDPOINT=
