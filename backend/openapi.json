  "components": {
    "schemas": {
      "Body_detectSources": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "FITS file to analyze"
          },
          "fwhm": {
            "type": "number",
            "minimum": 0.5,
            "title": "Fwhm",
            "default": 5.5
          },
          "sigma": {
            "type": "number",
            "minimum": 1.0,
            "title": "Sigma",
            "default": 9.0
          },
          "min_snr": {
            "type": "number",
            "minimum": 0.0,
            "title": "Min Snr",
            "default": 6.0
          },
          "min_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Min Score",
            "default": 0.18
          },
          "min_distance": {
            "type": "number",
            "minimum": 0.0,
            "title": "Min Distance",
            "default": 4.0
          },
          "visual_weight": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Visual Weight",
            "default": 0.8
          },
          "visual_area_radius": {
            "type": "number",
            "minimum": 1.0,
            "title": "Visual Area Radius",
            "default": 7.0
          },
          "visual_area_sigma": {
            "type": "number",
            "minimum": 0.0,
            "title": "Visual Area Sigma",
            "default": 2.0
          },
          "max_sources": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Max Sources",
            "default": 50
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_detectSources"
      },
      "Body_extractFitsMetadata": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "FITS file to inspect"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_extractFitsMetadata"
      },
      "Body_renderFitsHistogram": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "FITS file to render"
          },
          "bins": {
            "type": "integer",
            "maximum": 4096.0,
            "minimum": 2.0,
            "title": "Bins",
            "default": 256
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_renderFitsHistogram"
      },
      "Body_renderFitsImage": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "FITS file to render"
          },
          "stretch": {
            "type": "string",
            "pattern": "^(linear|sqrt|log|asinh)$",
            "title": "Stretch",
            "default": "sqrt"
          },
          "limits": {
            "type": "string",
            "pattern": "^(percentiles|zscale)$",
            "title": "Limits",
            "default": "percentiles"
          },
          "colormap": {
            "type": "string",
            "pattern": "^(grey|inverse|heat|rainbow|cube_helix)$",
            "title": "Colormap",
            "default": "grey"
          },
          "pmin": {
            "type": "number",
            "exclusiveMaximum": 100.0,
            "minimum": 0.0,
            "title": "Pmin",
            "default": 1.0
          },
          "pmax": {
            "type": "number",
            "maximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Pmax",
            "default": 99.0
          },
          "gamma": {
            "type": "number",
            "maximum": 5.0,
            "minimum": 0.1,
            "title": "Gamma",
            "default": 1.0
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_renderFitsImage"
