    "/image/{record_id}/sources": {
      "get": {
        "tags": [
          "sources"
        ],
        "summary": "Detect Sources",
        "operationId": "detectSources",
        "parameters": [
          {
            "name": "record_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Stored FITS record id",
              "title": "Record Id"
            },
            "description": "Stored FITS record id"
          },
          {
            "name": "hdu",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional image HDU index; defaults to the first 2D image HDU",
              "title": "Hdu"
            },
            "description": "Optional image HDU index; defaults to the first 2D image HDU"
          },
          {
            "name": "fwhm",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 0.5,
              "default": 5.5,
              "title": "Fwhm"
            }
          },
          {
            "name": "sigma",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 1.0,
              "default": 9.0,
              "title": "Sigma"
            }
          },
          {
            "name": "min_snr",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 0.0,
              "default": 6.0,
              "title": "Min Snr"
            }
          },
          {
            "name": "min_score",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 1.0,
              "minimum": 0.0,
              "default": 0.18,
              "title": "Min Score"
            }
          },
          {
            "name": "min_distance",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 0.0,
              "default": 4.0,
              "title": "Min Distance"
            }
          },
          {
            "name": "visual_weight",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 1.0,
              "minimum": 0.0,
              "default": 0.8,
              "title": "Visual Weight"
            }
          },
          {
            "name": "visual_area_radius",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 1.0,
              "default": 7.0,
              "title": "Visual Area Radius"
            }
          },
          {
            "name": "visual_area_sigma",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 0.0,
              "default": 2.0,
              "title": "Visual Area Sigma"
            }
          },
          {
            "name": "max_sources",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 50,
              "title": "Max Sources"
            }
          },
          {
            "name": "extended_min_snr",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 0.0,
              "default": 0.0,
              "title": "Extended Min Snr"
            }
          },
          {
            "name": "extended_max_sources",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 50,
              "title": "Extended Max Sources"
            }
          }
        ],
