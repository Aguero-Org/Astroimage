    "/image/{record_id}": {
      "get": {
        "tags": [
          "render"
        ],
        "summary": "Render Fits Image",
        "operationId": "renderFitsImage",
        "parameters": [
          {
            "name": "record_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Stored FITS record id",
              "title": "Record Id"
            },
            "description": "Stored FITS record id"
          },
          {
            "name": "hdu",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional image HDU index; defaults to the first 2D image HDU",
              "title": "Hdu"
            },
            "description": "Optional image HDU index; defaults to the first 2D image HDU"
          },
          {
            "name": "stretch",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(linear|sqrt|log|asinh)$",
              "default": "sqrt",
              "title": "Stretch"
            }
          },
          {
            "name": "limits",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(percentiles|zscale)$",
              "default": "percentiles",
              "title": "Limits"
            }
          },
          {
            "name": "colormap",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(grey|inverse|heat|rainbow|cube_helix)$",
              "default": "grey",
              "title": "Colormap"
            }
          },
          {
            "name": "pmin",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 0.0,
              "exclusiveMaximum": 100.0,
              "default": 1.0,
              "title": "Pmin"
            }
          },
          {
            "name": "pmax",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 100.0,
              "exclusiveMinimum": 0.0,
              "default": 99.0,
              "title": "Pmax"
            }
          },
          {
            "name": "gamma",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 5.0,
              "minimum": 0.1,
              "default": 1.0,
              "title": "Gamma"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              },
              "image/png": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
